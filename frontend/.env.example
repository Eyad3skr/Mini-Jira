# Frontend - leave empty in dev to use Vite proxy to backend :3001
VITE_API_URL=

# Set true only for local demo without Cognito (Ali/Sara/Omar quick login)
VITE_DEV_MOCK_LOGIN=false

# Cognito OIDC (SPA app client) — required for production sign-in
# Authority URL from Cognito console → User pool → Overview
VITE_COGNITO_AUTHORITY=https://cognito-idp.eu-north-1.amazonaws.com/eu-north-1_0DPcA2AgE
VITE_COGNITO_CLIENT_ID=your-spa-client-id
# Empty = current origin (http://localhost:5173 locally, CloudFront URL in prod)
VITE_COGNITO_REDIRECT_URI=
VITE_COGNITO_SCOPE=openid email profile

# Hosted UI domain (App integration → Domain) — required for SIGN OUT redirect
VITE_COGNITO_DOMAIN=https://eu-north-10dpca2age.auth.eu-north-1.amazoncognito.com
# Sign-out return URL (defaults to VITE_COGNITO_REDIRECT_URI or current origin)
VITE_COGNITO_LOGOUT_URI=

# Optional: build authority from pool id instead of VITE_COGNITO_AUTHORITY
VITE_COGNITO_USER_POOL_ID=eu-north-1_0DPcA2AgE
VITE_COGNITO_REGION=eu-north-1
