PORT=3001
NODE_ENV=development

# AWS region
AWS_REGION=us-east-1

# DynamoDB - use http://localhost:8000 for DynamoDB Local
DYNAMODB_ENDPOINT=
TABLE_PREFIX=mini-jira-

# Auth - set DEV_AUTH=true to use mock JWT (local dev without Cognito)
DEV_AUTH=true
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# S3
# Globally unique names, e.g. mini-jira-originals-<aws-account-id>
S3_ORIGINALS_BUCKET=mini-jira-originals-452031276830
S3_RESIZED_BUCKET=mini-jira-resized-452031276830
S3_PUBLIC_URL=

# SNS / events
EVENTS_ENABLED=true
SNS_ASSIGNMENT_TOPIC_ARN=arn:aws:sns:eu-north-1:452031276830:mini-jira-task-assignments
# Subscribe your inbox (must confirm AWS email before notifications arrive):
#   NOTIFY_EMAIL=you@example.com ./scripts/deploy-events.sh
# Check status: aws sns list-subscriptions-by-topic --topic-arn "$SNS_ASSIGNMENT_TOPIC_ARN" --region eu-north-1

# CloudWatch
CLOUDWATCH_NAMESPACE=MiniJira
